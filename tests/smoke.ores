// Native Oreslang behavioral smoke test. Run against Java/Truffle compiler.
// LLVM must remain a documented unsupported gate until native Array lowering.
import class IntLinkedQueue, QueueEntry from "../src/int_linked_queue";

pub routine main(): int {
  let IntLinkedQueue q = new IntLinkedQueue(8);
  if !q.initialize(); do return 1; fi
  if q.initialize(); do return 2; fi
  if !q.validate(); do return 3; fi
  if q.dequeue().is_some(); do return 4; fi

  if !q.enqueue(2, 20); do return 5; fi
  if !q.enqueue(5, 50); do return 6; fi
  if !q.add_to_front(0, 0); do return 7; fi
  if !q.insert_before(5, 3, 30); do return 8; fi
  if !q.insert_after(3, 4, 40); do return 9; fi

  // Order: 0, 2, 3, 4, 5
  if q.size() != 5; do return 10; fi
  if !q.validate(); do return 11; fi
  if q.ordered_keys().get(0) != 0; do return 12; fi
  if q.ordered_keys().get(1) != 2; do return 13; fi
  if q.ordered_keys().get(2) != 3; do return 14; fi
  if q.ordered_keys().get(3) != 4; do return 15; fi
  if q.ordered_keys().get(4) != 5; do return 16; fi
  if q.first().unwrap().value != 0; do return 17; fi
  if q.last().unwrap().key != 5; do return 18; fi

  // Every rejected operation must be a true no-op.
  if q.enqueue(2, 999); do return 19; fi
  if q.insert_after(6, 7, 70); do return 20; fi
  if q.insert_before(2, 2, 22); do return 21; fi
  if q.enqueue(-1, 123); do return 22; fi
  if q.enqueue(8, 123); do return 23; fi
  if q.size() != 5; do return 24; fi
  if q.get(2).unwrap() != 20; do return 25; fi
  if !q.validate(); do return 26; fi

  // Remove middle/head/tail, then reuse freed keys.
  if q.remove(3).unwrap().value != 30; do return 27; fi
  if q.dequeue().unwrap().key != 0; do return 28; fi
  if q.remove_last().unwrap().key != 5; do return 29; fi
  if !q.enqueue(3, 33); do return 30; fi
  if q.get(3).unwrap() != 33; do return 31; fi
  if q.get(0).is_some(); do return 32; fi
  if !q.validate(); do return 33; fi
  if q.size() != 3; do return 34; fi

  q.clear();
  if !q.is_empty(); do return 35; fi
  if q.first().is_some(); do return 36; fi
  if q.last().is_some(); do return 37; fi
  if q.get(3).is_some(); do return 38; fi
  if !q.validate(); do return 39; fi
  if !q.add_to_front(7, 70); do return 40; fi
  if q.dequeue().unwrap().key != 7; do return 41; fi
  if q.dequeue().is_some(); do return 42; fi
  if !q.validate(); do return 43; fi
  return 0;
}
