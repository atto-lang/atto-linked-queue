import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, expect_false, expect_equal_int, expect_equal_string, run_suite, require_success, fail from "ores.std/testing";
import class IntLinkedQueue from "../src/int_linked_queue";
fnc duplicate_enqueue_is_atomic(): TestOutcome {
  val IntLinkedQueue q = new IntLinkedQueue(2);
  if !q.initialize() || !q.enqueue(0, 41); then return fail("queue init/enqueue failed"); fi
  if q.enqueue(0, 99); then return fail("duplicate key was accepted"); fi
  return expect_true(q.validate() && q.size() == 1 && q.get(0).unwrap() == 41,
    "failed duplicate enqueue must preserve the original item");
}
fnc zero_payload_is_not_missing(): TestOutcome {
  val IntLinkedQueue q = new IntLinkedQueue(1);
  if !q.initialize() || !q.enqueue(0, 0); then return fail("zero payload insertion failed"); fi
  return expect_true(q.get(0).is_some() && q.dequeue().unwrap().value == 0
    && q.is_empty() && q.validate(), "zero value must survive extraction");
}
fnc invalid_remove_preserves_live_chain(): TestOutcome {
  val IntLinkedQueue q = new IntLinkedQueue(2);
  if !q.initialize() || !q.enqueue(1, 9); then return fail("queue setup rejected"); fi
  if q.remove(-1).is_some(); then return fail("invalid key removed a node"); fi
  return expect_true(q.size() == 1 && q.get(1).unwrap() == 9 && q.validate(),
    "rejected removal must not disturb queue links");
}
fnc negative_key_enqueue_is_atomic(): TestOutcome {
  val IntLinkedQueue q = new IntLinkedQueue(2);
  if !q.initialize(); then return fail("queue initialization failed"); fi
  if q.enqueue(-1, 55); then return fail("negative key was admitted"); fi
  return expect_true(q.validate() && q.size() == 0 && q.is_empty(),
    "invalid enqueue must leave a valid empty queue");
}

fnc repeated_clear_is_idempotent(): TestOutcome {
  val IntLinkedQueue q = new IntLinkedQueue(2);
  if !q.initialize() || !q.enqueue(0, 11); then return fail("queue setup failed"); fi
  q.clear();
  q.clear();
  return expect_true(q.is_empty() && q.size() == 0 && !q.get(0).is_some()
    && q.validate(), "repeated clear must not retain live links or values");
}

pub routine main(): void {
  val TestSuite suite = new TestSuite("linked-queue", arr[
    new TestCase("duplicate_enqueue_is_atomic", duplicate_enqueue_is_atomic, false, ""),
    new TestCase("zero_payload_is_not_missing", zero_payload_is_not_missing, false, ""),
    new TestCase("invalid_remove_preserves_live_chain", invalid_remove_preserves_live_chain, false, ""),
    new TestCase("negative_key_enqueue_is_atomic", negative_key_enqueue_is_atomic, false, ""),
    new TestCase("repeated_clear_is_idempotent", repeated_clear_is_idempotent, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
